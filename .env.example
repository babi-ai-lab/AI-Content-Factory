# Supabase public client configuration (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini server-side configuration (required for real AI generation)
# Keep this secret out of Git and browser-side code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Instagram Graph API (Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://app.eltbabak.ir/integrations/instagram/callback
# Base64-encoded 32-byte AES-GCM key; keep identical in Render and Supabase Vault.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_API_VERSION=v26.0
# Enable only after Supabase Vault secrets and the cron schedule are configured.
INSTAGRAM_SCHEDULER_ENABLED=false

# Supabase public client configuration (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini server-side configuration (required for real AI generation)
# Keep this secret out of Git and browser-side code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Generate a random 32-byte key and store its base64 value; never expose it to the browser.
# Optional; default is v26.0.

# Set true only after Supabase Vault secrets and the pg_cron job are configured.
